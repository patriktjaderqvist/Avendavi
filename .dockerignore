# VCS
.git
.gitignore
.gitattributes

# Dependencies / build artifacts (rebuilt inside the image)
node_modules
dist
build
.next
.turbo
.cache
.parcel-cache

# Local envs and secrets — never bake into an image
.env
.env.*
!.env.example

# Vercel / Netlify / Vite local state
.vercel
.netlify
.vite

# Python (if anyone adds tooling later)
__pycache__
*.py[cod]
.venv

# Editor / OS noise
.idea
.vscode
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docs / infra that doesn't need to be inside the image
README.md
MIGRATION_NOTES.md
Dockerfile
docker-compose.yml
.dockerignore
